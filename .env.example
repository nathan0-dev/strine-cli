# Copie este arquivo para .env e preencha com sua chave real.
ANTHROPIC_API_KEY=sk-ant-...

# Opcionais — usados por algumas tools do agent:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# SLACK_BOT_TOKEN=xoxb-...
# TAVILY_API_KEY=tvly-...
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Seu Nome <voce@seudominio.com>

# Uma key por provider de IA — configure a do provider que for usar
# (escolha com --provider; o padrão é claude):
# GEMINI_API_KEY=...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# STRINE_DEFAULT_PROVIDER=claude
