# Copy this file to .env and fill in your real key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — used by some agent tools:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# SLACK_BOT_TOKEN=xoxb-...
# TAVILY_API_KEY=tvly-...
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Your Name <you@yourdomain.com>

# One key per AI provider — set the one for the provider you'll use
# (choose with --provider; the default is claude):
# GEMINI_API_KEY=...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# STRINE_DEFAULT_PROVIDER=claude
